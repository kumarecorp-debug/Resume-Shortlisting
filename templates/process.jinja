    <!-- Copied History Side Panel Overlay -->
    <div id="copied-panel-overlay" class="side-panel-overlay"></div>
    <div id="copied-side-panel" class="side-panel" style="width: 500px;">
        <div class="side-panel-header" style="height: 52px; padding: 0 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; background: #f8fafc;">
            <h3 class="side-panel-title" style="font-size: 1.05rem; font-weight: 700; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                <span>Copied History</span>
            </h3>
            <button type="button" id="btn-close-copied" class="side-panel-close" aria-label="Close Side Panel" style="background: transparent; border: none; font-size: 1.1rem; color: #64748b; cursor: pointer; padding: 4px;">✕</button>
        </div>
