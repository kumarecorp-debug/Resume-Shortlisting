    <!-- Modal: Skip Already-Copied Prompt -->
    <div id="skip-copied-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px); z-index: 10010; align-items: center; justify-content: center; padding: 20px;" role="dialog" aria-modal="true">
        <div style="background: var(--bg-card); color: var(--text-primary); width: 100%; max-width: 560px; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); border: 1px solid var(--border); padding: 28px; animation: slideInToast 0.25s ease-out;">
            <div style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
                <span>🔔</span> You've copied from this search before
            </div>
            <div style="font-size: 0.9rem; line-height: 1.5; color: var(--text-secondary); margin-bottom: 16px;">
                <p style="margin: 4px 0;"><strong>Mailbox:</strong> <span id="modal-skip-mailbox" style="color: var(--accent);"></span></p>
                <p style="margin: 4px 0;"><strong>Search:</strong> "<span id="modal-skip-jd" style="color: var(--text-primary);"></span>"</p>
                <p style="margin: 12px 0 6px 0;">You have already copied <strong id="modal-skip-count" style="color: var(--accent);">0</strong> candidate(s) for this search:</p>
                <div id="modal-skip-list" style="background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 10px 16px; max-height: 120px; overflow-y: auto; font-size: 0.86rem; color: var(--text-primary);"></div>
            </div>
            <div style="font-weight: 600; font-size: 0.92rem; margin-bottom: 16px; color: var(--text-primary);">How should this search behave?</div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button type="button" id="btn-skip-choice-skip" style="background: var(--accent); color: white; border: none; padding: 12px 18px; border-radius: var(--radius-md); font-weight: 600; cursor: pointer; text-align: left; transition: var(--transition-fast);">
                    🆕 Skip already-copied (<span id="btn-skip-count-text">0</span> hidden)
                </button>
                <button type="button" id="btn-skip-choice-show" style="background: var(--bg-primary); color: var(--text-primary); border: 1px solid var(--border); padding: 12px 18px; border-radius: var(--radius-md); font-weight: 600; cursor: pointer; text-align: left; transition: var(--transition-fast);">
                    🔁 Show everything (including <span id="btn-show-count-text">0</span>)
                </button>
                <button type="button" id="btn-skip-choice-cancel" style="background: transparent; color: var(--text-muted); border: none; padding: 8px; font-size: 0.88rem; cursor: pointer; margin-top: 4px;">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <footer style="text-align: center; padding: 24px 16px; color: #64748b; font-size: 0.88rem; background: transparent; border: none;">
        <p style="margin: 0;">© 2026 ResuMatch — Minimal AI Resume Shortlisting & Candidate Extraction Engine</p>
    </footer>

    <script src="{{ url_for('static', filename='icons/icons.js') }}"></script>
    <script src="{{ url_for('static', filename='js/ui.js') }}"></script>
    <script src="{{ url_for('static', filename='js/pagination.js') }}"></script>
    <script src="{{ url_for('static', filename='js/search-popups.js') }}"></script>
    <script src="{{ url_for('static', filename='js/copied-history-panel.js') }}"></script>
    <script src="{{ url_for('static', filename='js/copy.js') }}"></script>
    <script>
        window.__candidates = {{ table_data|tojson if table_data else [] }};

        function updateAccountBadge(accountEmail) {
            const badge = document.getElementById('active-mail-label');
            if (badge) {
                badge.textContent = accountEmail;
            }
            try {
                localStorage.setItem('preferred_account', accountEmail);
            } catch(e) {}
        }

        const searchForm = document.getElementById('search-form');
        if (searchForm) {
            searchForm.addEventListener('submit', function() {
                const indicator = document.getElementById('loading-indicator');
                const messageElem = document.getElementById('loading-message');
                const selectedMail = document.getElementById('account_email') ? document.getElementById('account_email').value : 'selected mailbox';
                if (indicator) indicator.style.display = 'block';

                const progressSteps = [
                    `Authenticating with ${selectedMail}...`,
                    `Searching mailbox ${selectedMail} for relevant candidate emails...`,
                    "Filtering and downloading resume attachments (.pdf, .docx, .doc)...",
                    "Extracting candidate contact info (Email & Phone Number)...",
                    "Analyzing Skills & Work Experience with AI...",
                    "Calculating JD Match Scores & Ranking Candidates..."
                ];

                let stepIdx = 0;
                if (messageElem) messageElem.textContent = progressSteps[stepIdx];
                const interval = setInterval(() => {
                    stepIdx = (stepIdx + 1) % progressSteps.length;
                    if (messageElem) messageElem.textContent = progressSteps[stepIdx];
                }, 2500);

                sessionStorage.setItem('loadingInterval', interval);
            });
        }

        window.addEventListener('load', function() {
            const interval = sessionStorage.getItem('loadingInterval');
            if (interval) {
                clearInterval(interval);
                sessionStorage.removeItem('loadingInterval');
            }
        });

        function setQuery(text) {
            const input = document.getElementById('job_query');
            if (input) {
                input.value = text;
                input.focus();
                triggerDebouncedGmailCount();
            }
        }

        // ============================================================
        // TIME WINDOW & SHOW MODE CONTROL LOGIC
        // ============================================================
        let countDebounceTimer = null;
        let autoRefreshTimer = null;
        let refreshInProgress = false;
        let currentTimeWindow = 'any';
        let consecutiveFailures = 0;
        let backoffDelayMs = 0;

        function formatDateIso(d) {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function getTodayIso() {
            return formatDateIso(new Date());
        }

        function getDaysAgoIso(days) {
            const d = new Date();
            d.setDate(d.getDate() - days);
            return formatDateIso(d);
        }

        function setTimeWindow(win) {
            const twInput = document.getElementById('time_window');
            const dpInput = document.getElementById('date_preset');
            if (twInput) twInput.value = win;
            if (dpInput) dpInput.value = win;

            try { localStorage.setItem('search_time_window', win); } catch (e) {}

            const pills = document.querySelectorAll('#time-window-pill-container .time-pill-btn');
            pills.forEach(b => {
                if (b.getAttribute('data-window') === win || b.getAttribute('data-time-window') === win) {
                    b.classList.add('active');
                } else {
                    b.classList.remove('active');
                }
            });

            const customPanel = document.getElementById('custom-date-panel');
            if (win === 'custom') {
                if (customPanel) customPanel.style.display = 'block';
                const fromInput = document.getElementById('custom_date_from');
                const toInput = document.getElementById('custom_date_to');
                if (!fromInput.value) fromInput.value = getDaysAgoIso(6);
                if (!toInput.value) toInput.value = getTodayIso();
                onCustomDateChange();
            } else {
                if (customPanel) customPanel.style.display = 'none';
            }
            onTimeWindowSelected(win);
        }

        function closeCustomPanel() {
            setTimeWindow('any');
        }

        function setShowMode(mode) {
            const modeInput = document.getElementById('show_mode');
            if (modeInput) modeInput.value = mode;

            try { localStorage.setItem('search_show_mode', mode); } catch (e) {}

            const pills = document.querySelectorAll('#show-mode-pill-container .show-pill-btn');
            pills.forEach(b => {
                if (b.getAttribute('data-show') === mode) {
                    b.classList.add('active');
                } else {
                    b.classList.remove('active');
                }
            });
        }

        function applyCustomPreset(preset) {
            const fromInput = document.getElementById('custom_date_from');
            const toInput = document.getElementById('custom_date_to');
            const today = getTodayIso();

            if (preset === '7d') {
                fromInput.value = getDaysAgoIso(6);
                toInput.value = today;
            } else if (preset === '30d') {
                fromInput.value = getDaysAgoIso(29);
                toInput.value = today;
            } else if (preset === 'month') {
                const now = new Date();
                const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
                fromInput.value = formatDateIso(firstDay);
                toInput.value = today;
            } else if (preset === 'reset') {
                fromInput.value = getDaysAgoIso(6);
                toInput.value = today;
            }
            onCustomDateChange();
        }

        function onCustomDateChange() {
            const fromInput = document.getElementById('custom_date_from');
            const toInput = document.getElementById('custom_date_to');
            const fromHidden = document.getElementById('date_from_hidden');
            const toHidden = document.getElementById('date_to_hidden');
            const errorElem = document.getElementById('custom-date-error');
            const previewElem = document.getElementById('custom-date-preview');

            const fromVal = fromInput ? fromInput.value : '';
            const toVal = toInput ? toInput.value : '';

            if (fromHidden) fromHidden.value = fromVal;
            if (toHidden) toHidden.value = toVal;

            try {
                localStorage.setItem('search_date_from', fromVal);
                localStorage.setItem('search_date_to', toVal);
            } catch(e) {}

            if (fromVal && toVal && fromVal > toVal) {
                if (toInput) toInput.classList.add('error');
                if (errorElem) errorElem.style.display = 'block';
                if (previewElem) previewElem.textContent = '';
                if (typeof showToast === 'function') {
                    showToast('⚠️ From date must be before or equal to To date', true);
                }
                return false;
            } else {
                if (toInput) toInput.classList.remove('error');
                if (errorElem) errorElem.style.display = 'none';
            }

            if (fromVal && toVal) {
                try {
                    const d1 = new Date(fromVal);
                    const d2 = new Date(toVal);
                    const opts = { month: 'short', day: 'numeric', year: 'numeric' };
                    const str1 = d1.toLocaleDateString('en-US', opts);
                    const str2 = d2.toLocaleDateString('en-US', opts);
                    if (previewElem) previewElem.textContent = `Searching emails from ${str1} to ${str2}`;
                } catch(e) {
                    if (previewElem) previewElem.textContent = `Searching emails from ${fromVal} to ${toVal}`;
                }
            } else {
                if (previewElem) previewElem.textContent = '';
            }

            triggerDebouncedGmailCount();
            return true;
        }

        function setDatePreset(preset) {
            setTimeWindow(preset);
        }

        function triggerDebouncedGmailCount() {
            if (countDebounceTimer) clearTimeout(countDebounceTimer);
            countDebounceTimer = setTimeout(() => {
                refreshAllCounts();
            }, 500);
        }

        async function refreshTimeWindowCount(window_key) {
            if (!window_key || window_key === 'any' || window_key === 'custom') return;
            
            const mailbox = document.getElementById('account_email')?.value || '';
            const jd = document.getElementById('job_query')?.value?.trim() || '';
            if (!mailbox || !jd) return;

            const pill = document.querySelector(`[data-time-window="${window_key}"]`) || document.querySelector(`[data-window="${window_key}"]`);
            if (!pill) return;

            const oldCount = parseInt(pill.dataset.count || '-1', 10);
            pill.classList.add('pill-loading');

            try {
                const url = `/api/gmail/count?mailbox=${encodeURIComponent(mailbox)}&jd=${encodeURIComponent(jd)}&time_window=${encodeURIComponent(window_key)}`;
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 5000);

                const res = await fetch(url, { signal: controller.signal });
                clearTimeout(timeoutId);

                if (res.status === 429) {
                    consecutiveFailures++;
                    if (consecutiveFailures === 1) backoffDelayMs = 60000;
                    else if (consecutiveFailures === 2) backoffDelayMs = 120000;
                    else backoffDelayMs = 300000;
                    console.warn(`[count] Rate limited (429). Backing off for ${backoffDelayMs / 1000}s`);
                    startAutoRefresh();
                    return;
                }

                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                const newCount = data.count;

                consecutiveFailures = 0;
                backoffDelayMs = 0;

                updatePillCount(pill, window_key, newCount);

                if (oldCount >= 0 && newCount !== oldCount) {
                    pill.classList.add('pill-updated');
                    setTimeout(() => pill.classList.remove('pill-updated'), 2000);
                    console.log(`[count] ${window_key}: ${oldCount} → ${newCount}`);
                }
            } catch (err) {
                console.error(`[count] refresh failed for ${window_key}:`, err);
            } finally {
                pill.classList.remove('pill-loading');
            }
        }

        function updatePillCount(pill, window_key, count) {
            if (!pill) return;
            pill.dataset.count = count;
            const countSpan = pill.querySelector('.pill-count') || document.getElementById(`count-pill-${window_key}`);
            if (countSpan) {
                countSpan.textContent = (count !== undefined && count !== null && count >= 0) ? ` (${count.toLocaleString()})` : '';
            }
        }

        async function refreshAllCounts() {
            const btn = document.getElementById('btn-refresh-counts');
            if (btn) {
                if (btn.disabled) return;
                btn.disabled = true;
                btn.classList.add('spinning');
            }
            try {
                const windows = ['today', 'yesterday', '7d', '14d', '30d'];
                await Promise.all(windows.map(w => refreshTimeWindowCount(w)));
            } finally {
                if (btn) {
                    setTimeout(() => {
                        btn.disabled = false;
                        btn.classList.remove('spinning');
                    }, 500);
                }
            }
        }

        function startAutoRefresh() {
            stopAutoRefresh();
            const interval = backoffDelayMs > 0 ? backoffDelayMs : (5 * 60 * 1000);
            autoRefreshTimer = setInterval(() => {
                if (document.hidden) return;
                if (currentTimeWindow === 'any' || currentTimeWindow === 'custom') return;
                refreshTimeWindowCount(currentTimeWindow);
            }, interval);
        }

        function stopAutoRefresh() {
            if (autoRefreshTimer) clearInterval(autoRefreshTimer);
            autoRefreshTimer = null;
        }

        function onTimeWindowSelected(window_key) {
            currentTimeWindow = window_key;
            if (window_key !== 'any' && window_key !== 'custom') {
                refreshTimeWindowCount(window_key);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const urlJd = params.get('jd') || params.get('job_query');
            const urlWindow = params.get('time_window') || params.get('date_preset');
            const urlFrom = params.get('date_from');
            const urlTo = params.get('date_to');
            const urlMode = params.get('show_mode');
            const urlExp = params.get('exp') || params.get('min_exp');

            if (urlJd) {
                const jdInput = document.getElementById('job_query');
                if (jdInput) jdInput.value = urlJd;
            }
            if (urlExp) {
                const expInput = document.getElementById('min_exp');
                if (expInput) expInput.value = urlExp;
            }

            const savedWin = urlWindow || localStorage.getItem('search_time_window') || '{{ time_window or "any" }}';
            const savedMode = urlMode || localStorage.getItem('search_show_mode') || '{{ show_mode or "all" }}';
            const savedFrom = urlFrom || localStorage.getItem('search_date_from') || '{{ date_from or "" }}';
            const savedTo = urlTo || localStorage.getItem('search_date_to') || '{{ date_to or "" }}';

            if (savedFrom) {
                const fromHidden = document.getElementById('date_from_hidden');
                if (fromHidden) fromHidden.value = savedFrom;
                const customFrom = document.getElementById('custom_date_from');
                if (customFrom) customFrom.value = savedFrom;
            }
            if (savedTo) {
                const toHidden = document.getElementById('date_to_hidden');
                if (toHidden) toHidden.value = savedTo;
                const customTo = document.getElementById('custom_date_to');
                if (customTo) customTo.value = savedTo;
            }

            setTimeWindow(savedWin);
            setShowMode(savedMode);
            startAutoRefresh();

            const jdInput = document.getElementById('job_query');
            if (jdInput) {
                jdInput.addEventListener('input', function() {
                    triggerDebouncedGmailCount();
                });
            }

            const refreshBtn = document.getElementById('btn-refresh-counts');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', refreshAllCounts);
            }

            function setupSearchProgressPolling() {
                const searchMeta = document.getElementById('pagination-meta');
                const searchId = searchMeta ? searchMeta.getAttribute('data-search-id') : '';
                const isAsync = searchMeta ? (searchMeta.getAttribute('data-is-async') === 'true') : false;

                if (searchId && (isAsync || document.getElementById('loading-indicator')?.style.display !== 'none')) {
                    const loadingBox = document.getElementById('loading-indicator');
                    const progressFill = document.getElementById('progress-fill');
                    const targetCount = document.getElementById('target-count');
                    const foundRelevant = document.getElementById('found-relevant');
                    const resumesExtracted = document.getElementById('resumes-extracted');
                    const emailsScanned = document.getElementById('emails-scanned');
                    const progressPct = document.getElementById('progress-pct');
                    const progressEtaDiv = document.getElementById('progress-eta');
                    const loadingMessage = document.getElementById('loading-message');

                    if (loadingBox) loadingBox.style.display = 'block';

                    const pollInterval = setInterval(async () => {
                        try {
                            const res = await fetch(`/api/search/progress/${searchId}`).then(r => r.json());
                            if (res) {
                                const pct = res.percentage || 0;
                                if (progressFill) progressFill.style.width = pct + '%';
                                if (targetCount) targetCount.innerText = res.target || 25;
                                if (foundRelevant) foundRelevant.innerText = res.found_relevant || 0;
                                if (resumesExtracted) resumesExtracted.innerText = res.resumes_extracted || 0;
                                if (emailsScanned) emailsScanned.innerText = res.emails_scanned || 0;
                                if (progressPct) progressPct.innerText = pct;
                                if (progressEtaDiv) progressEtaDiv.innerHTML = `⏳ <span>${pct}</span>% · ~${res.eta_seconds || 0}s remaining`;
                                if (loadingMessage && res.message) loadingMessage.innerText = res.message;
                            }
                            if (res && res.status === 'done') {
                                clearInterval(pollInterval);
                                if (loadingMessage) loadingMessage.innerText = "✅ Search complete! Loading candidate table...";
                                const jq = encodeURIComponent(searchMeta.getAttribute('data-job-query') || '');
                                const mb = encodeURIComponent(searchMeta.getAttribute('data-mailbox') || '');
                                window.location.href = `/process?search_id=${searchId}&jd=${jq}&account_email=${mb}&search_mode=live`;
                            } else if (res && res.status === 'error') {
                                clearInterval(pollInterval);
                                if (loadingMessage) loadingMessage.innerText = `⚠️ Search Notice: ${res.message || 'Error occurred'}`;
                            }
                        } catch (e) {
                            console.error('[progress] poll error:', e);
                        }
                    }, 800);
                }
            }

            setupSearchProgressPolling();

            if (searchForm) {
                searchForm.addEventListener('submit', function() {
                    const submitBtn = searchForm.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.style.opacity = '0.75';
                        submitBtn.innerHTML = '⌛ Searching Mailbox & Extracting...';
                    }
                    const loadingBox = document.getElementById('loading-indicator');
                    if (loadingBox) loadingBox.style.display = 'block';
                });
            }
        });

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                stopAutoRefresh();
            } else {
                if (currentTimeWindow !== 'any' && currentTimeWindow !== 'custom') {
                    refreshTimeWindowCount(currentTimeWindow);
                }
                startAutoRefresh();
            }
        });

    </script>
</body>
</html>