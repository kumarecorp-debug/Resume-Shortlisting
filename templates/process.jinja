<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ResuMatch — Minimal AI Resume Search & Recruiter Engine</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='index.css') }}">
</head>
<body>
    <!-- Top Navigation Bar -->
    <nav class="navbar">
        <a href="{{ url_for('process') }}" class="nav-brand">
            <span class="nav-brand-logo" data-icon="target" data-size="16"></span>
            <span>ResuMatch</span>
        </a>
        <div class="nav-right">
            <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" title="Toggle Light/Dark Theme" aria-label="Toggle Dark Mode">
                <span id="theme-icon" data-icon="moon" data-size="16"></span>
            </button>
            <button type="button" id="btn-history-panel" class="nav-btn" aria-label="View Search History">
                <span data-icon="history" data-size="14"></span> History
            </button>
            <button type="button" id="btn-copied-panel" class="nav-btn" style="position: relative;" aria-label="View Copied History">
                <span data-icon="copy" data-size="14"></span> Copied History
                <span id="copied-history-badge" style="display: none; position: absolute; top: -6px; right: -6px; background: var(--danger); color: white; font-size: 0.72rem; font-weight: 700; padding: 2px 6px; border-radius: 10px; border: 1.5px solid #0F172A;">0</span>
            </button>
            <div class="user-menu-btn">
                <span data-icon="user" data-size="14"></span>
                <span>{{ session['user']['email'] if session.get('user') else 'Authenticated User' }}</span>
            </div>
            <a href="{{ url_for('logout') }}" class="nav-btn" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.25); color: #ef4444;" aria-label="Sign Out">
                <span data-icon="logout" data-size="14"></span> Sign Out
            </a>
        </div>
    </nav>

    <div class="container">
        <!-- Single Compact Search Card -->
        <div class="card search-card">
            <form method="POST" action="{{ url_for('process') }}" id="search-form">
                <!-- Top Bar: Mailbox & Candidate Limit -->
                <div class="form-row form-row-top">
                    <div class="form-field-inline">
                        <label for="account_email" class="field-label-sm">
                            <span data-icon="mail" data-size="14"></span> Mailbox Account:
                        </label>
                        <select name="account_email" id="account_email" class="form-select-sm" onchange="updateAccountBadge(this.value)">
                            {% for acct in available_accounts %}
                                <option value="{{ acct.email }}" {% if selected_account == acct.email %}selected{% endif %}>
                                    {{ acct.name }} ({{ acct.email }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-field-inline">
                        <label for="max_candidates" class="field-label-sm">
                            <span data-icon="target" data-size="14"></span> Candidate Limit:
                        </label>
                        <select name="max_candidates" id="max_candidates" class="form-select-sm">
                            <option value="25" {% if max_candidates == 25 %}selected{% endif %}>Fast Batch (25 Candidates)</option>
                            <option value="50" {% if max_candidates == 50 %}selected{% endif %}>Medium Batch (50 Candidates)</option>
                            <option value="100" {% if max_candidates == 100 %}selected{% endif %}>Large Batch (100 Candidates)</option>
                            <option value="200" {% if max_candidates == 200 or not max_candidates %}selected{% endif %}>Extra Large Batch (200 Candidates)</option>
                            <option value="500" {% if max_candidates == 500 %}selected{% endif %}>Fetch All (up to 500 Candidates)</option>
                        </select>
                    </div>
                </div>

                {% with messages = get_flashed_messages(with_categories=true) %}
                    {% if messages %}
                        {% for category, message in messages %}
                            <div class="alert alert-{{ category }}">
                                <span data-icon="alert-circle" data-size="16"></span>
                                <span>{{ message }}</span>
                            </div>
                        {% endfor %}
                    {% endif %}
                {% endwith %}

                <!-- Main Job Query Field (Google Search UI/UX) -->
                <div class="form-group-compact">
                    <label for="job_query" class="field-label">
                        <span data-icon="search" data-size="14"></span> Enter Job Role, Keywords, or Paste Full Job Description (supports <code>AND</code> / <code>OR</code>):
                    </label>
                    <div class="textarea-wrapper">
                        <span class="google-search-icon" data-icon="search" data-size="18"></span>
                        <textarea 
                            name="job_query" 
                            id="job_query" 
                            class="form-textarea google-search-input" 
                            rows="2"
                            placeholder="e.g. Python AND SQL, SFDC agentic core workflows, or paste a full Job Description..." 
                            required
                        >{{ job_query if job_query else '' }}</textarea>
                    </div>
                </div>

                <!-- Form Options: Experience & Excel Checkbox -->
                <div class="form-options-row">
                    <div class="form-field-inline">
                        <label for="min_exp" class="field-label-sm">
                            <span data-icon="clock" data-size="14"></span> Min Exp (years):
                        </label>
                        <input 
                            type="number" 
                            name="min_exp" 
                            id="min_exp" 
                            step="0.5" 
                            min="0" 
                            max="50" 
                            placeholder="Any" 
                            value="{{ min_exp if min_exp is not none else '' }}" 
                            class="form-input-sm"
                            style="width: 75px; text-align: center;"
                        >
                        <span style="color: var(--text-muted); font-size: 12px;">(Optional — leave blank to show all)</span>
                    </div>

                </div>

                <div class="form-divider"></div>

                <!-- Compact Time Window & Show Filter Controls -->
                <div class="form-filters-compact">
                    <input type="hidden" name="time_window" id="time_window" value="{{ time_window or date_preset or 'any' }}">
                    <input type="hidden" name="date_preset" id="date_preset" value="{{ time_window or date_preset or 'any' }}">
                    <input type="hidden" name="date_from" id="date_from_hidden" value="{{ date_from or '' }}">
                    <input type="hidden" name="date_to" id="date_to_hidden" value="{{ date_to or '' }}">
                    <input type="hidden" name="show_mode" id="show_mode" value="{{ show_mode or 'all' }}">

                    <div class="pill-group-row">
                        <span class="group-label"><span data-icon="calendar" data-size="14"></span> Time Window:</span>
                        <div class="pill-container" id="time-window-pill-container">
                            <button type="button" class="pill-btn {% if not time_window or time_window == 'any' %}active{% endif %}" data-window="any" data-time-window="any" onclick="setTimeWindow('any')">Any</button>
                            <button type="button" class="pill-btn {% if time_window == 'today' %}active{% endif %}" data-window="today" data-time-window="today" onclick="setTimeWindow('today')">Today<span class="pill-count" id="count-pill-today"></span></button>
                            <button type="button" class="pill-btn {% if time_window == 'yesterday' %}active{% endif %}" data-window="yesterday" data-time-window="yesterday" onclick="setTimeWindow('yesterday')">Yesterday<span class="pill-count" id="count-pill-yesterday"></span></button>
                            <button type="button" class="pill-btn {% if time_window == '7d' %}active{% endif %}" data-window="7d" data-time-window="7d" onclick="setTimeWindow('7d')">7d<span class="pill-count" id="count-pill-7d"></span></button>
                            <button type="button" class="pill-btn {% if time_window == '14d' %}active{% endif %}" data-window="14d" data-time-window="14d" onclick="setTimeWindow('14d')">14d<span class="pill-count" id="count-pill-14d"></span></button>
                            <button type="button" class="pill-btn {% if time_window == '30d' %}active{% endif %}" data-window="30d" data-time-window="30d" onclick="setTimeWindow('30d')">30d<span class="pill-count" id="count-pill-30d"></span></button>
                            <button type="button" class="pill-btn {% if time_window == 'custom' %}active{% endif %}" data-window="custom" data-time-window="custom" onclick="setTimeWindow('custom')">Custom</button>
                        </div>
                        <button type="button" id="btn-refresh-counts" class="btn-ghost-icon" title="Refresh email counts" aria-label="Refresh email counts" onclick="refreshAllCounts()">
                            <span data-icon="refresh-cw" data-size="14"></span>
                        </button>
                        <button type="button" onclick="setTimeWindow('any')" class="btn-ghost-icon" style="font-size: 12px; color: var(--accent);" title="Reset Time Window">Reset</button>
                    </div>

                    <!-- Custom Date Range Panel -->
                    <div id="custom-date-panel" class="custom-date-panel" style="display: {% if time_window == 'custom' %}block{% else %}none{% endif %};">
                        <div class="custom-date-header">
                            <span><span data-icon="calendar" data-size="14"></span> Custom Date Range</span>
                            <button type="button" onclick="closeCustomPanel()" class="btn-ghost-icon"><span data-icon="x" data-size="14"></span></button>
                        </div>
                        <div class="custom-date-inputs">
                            <div class="form-field-inline">
                                <label for="custom_date_from" class="field-label-sm">From:</label>
                                <input type="date" id="custom_date_from" class="form-input-sm" value="{{ date_from or '' }}" onchange="onCustomDateChange()">
                            </div>
                            <div class="form-field-inline">
                                <label for="custom_date_to" class="field-label-sm">To:</label>
                                <input type="date" id="custom_date_to" class="form-input-sm" value="{{ date_to or '' }}" onchange="onCustomDateChange()">
                            </div>
                        </div>
                        <div class="custom-presets-row">
                            <span class="sub-label">Quick:</span>
                            <button type="button" class="btn-sub-preset" onclick="applyCustomPreset('7d')">Last 7d</button>
                            <button type="button" class="btn-sub-preset" onclick="applyCustomPreset('30d')">Last 30d</button>
                            <button type="button" class="btn-sub-preset" onclick="applyCustomPreset('month')">This month</button>
                            <button type="button" class="btn-sub-preset" onclick="applyCustomPreset('reset')">Reset</button>
                        </div>
                        <div id="custom-date-preview" class="date-preview"></div>
                        <div id="custom-date-error" class="date-error" style="display: none;">To date must be after From date</div>
                    </div>

                    <div class="pill-group-row">
                        <span class="group-label"><span data-icon="users" data-size="14"></span> Show:</span>
                        <div class="pill-container" id="show-mode-pill-container">
                            <button type="button" class="pill-btn {% if not show_mode or show_mode == 'all' %}active{% endif %}" data-show="all" onclick="setShowMode('all')">All</button>
                            <button type="button" class="pill-btn {% if show_mode == 'copied' %}active{% endif %}" data-show="copied" onclick="setShowMode('copied')">Copied</button>
                            <button type="button" class="pill-btn {% if show_mode == 'not_copied' %}active{% endif %}" data-show="not_copied" onclick="setShowMode('not_copied')">Not copied</button>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary-lg">
                        <span data-icon="search" data-size="16"></span> Search Mailbox & Extract
                    </button>
                </div>
            </form>

            <div id="loading-indicator" class="loader-box" style="display: none;">
                <div class="spinner-sm"></div>
                <h4 id="loading-message" class="loading-title">Connecting to mailbox...</h4>
                <p class="loading-desc">Please wait while we search emails, download attachments, and extract candidate details with AI.</p>
            </div>
        </div>

        {% if table_data is not none and table_data|length > 0 %}
            <div id="pagination-meta" data-search-id="{{ search_id or '' }}" data-job-query="{{ job_query or '' }}" data-mailbox="{{ selected_account or '' }}" data-total="{{ total_matches or table_data|length }}" data-offset="{{ table_data|length }}" data-limit="{{ page_size or 25 }}" data-min-exp="{{ min_exp if min_exp is not none else '' }}" data-hidden-exp="{{ hidden_by_experience or 0 }}"></div>

            {% if scan_summary %}
                <div style="background: var(--bg-subtle); border: 1px solid var(--border); color: var(--text-primary); padding: 8px 14px; border-radius: var(--radius-md); font-size: 13px; font-weight: 500; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                    <span data-icon="file-text" data-size="14"></span>
                    <span>Scan Summary: Scanned {{ scan_summary.get('pdf', 0) }} PDFs, {{ scan_summary.get('docx', 0) }} DOCX resumes &nbsp;·&nbsp; Found {{ total_matches }} matching candidates</span>
                </div>
            {% endif %}

            <div class="card">
                <div class="table-controls" style="flex-wrap: wrap; gap: 10px;">
                    <div>
                        <h2 style="margin: 0; font-size: 1.1rem; color: var(--text-primary); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;" id="candidates-count-title">
                            <span>
                                {% if search_mode in ['email', 'phone', 'name'] %}
                                    Search: "{{ job_query }}"{% if min_exp is not none %} &nbsp;·&nbsp; Min Exp: {{ min_exp }}+ yrs{% endif %}{% if date_display %} &nbsp;·&nbsp; {{ date_display }}{% endif %} &nbsp;·&nbsp; Mode: {{ search_mode|capitalize }} &nbsp;·&nbsp;
                                    {{ exact_matches if exact_matches is defined else table_data|length }} exact &nbsp;·&nbsp; {{ approx_matches if approx_matches is defined else 0 }} approx
                                {% else %}
                                    Search: '{{ job_query }}'{% if min_exp is not none %} &nbsp;·&nbsp; Min Exp: {{ min_exp }}+ yrs{% endif %}{% if date_display %} &nbsp;·&nbsp; {{ date_display }}{% endif %} &nbsp;·&nbsp; <span id="visible-count">{{ table_data|length }}</span> matches<span id="hidden-used-text"></span>
                                {% endif %}
                            </span>
                            
                            {% if search_mode in ['email', 'phone', 'name'] %}
                                <span class="badge-status badge-status-used" style="text-transform: capitalize;">
                                    <span data-icon="target" data-size="12"></span> Mode: {{ search_mode }}
                                </span>
                                {% if approx_matches and approx_matches > 0 %}
                                    <span class="badge-status badge-status-skipped">
                                        <span data-icon="alert-triangle" data-size="12"></span> Approx matches
                                    </span>
                                {% endif %}
                            {% else %}
                                <span class="badge-status" style="background: var(--bg-subtle); color: var(--text-secondary); border: 1px solid var(--border);">
                                    <span data-icon="search" data-size="12"></span> Mode: Keyword
                                </span>
                            {% endif %}

                            <a href="#" id="link-change-copy-pref" onclick="reopenCopyPrefModal(event)" style="font-size: 12px; color: var(--accent); font-weight: 500; text-decoration: none; margin-left: 8px; display: none;">
                                Change preference
                            </a>
                        </h2>
                        {% if job_role %}
                            <p style="margin: 2px 0 0 0; color: var(--text-secondary); font-size: 12px;" title="{{ job_role }}">
                                Target JD / Role: <strong>{{ job_role[:110] }}{% if job_role|length > 110 %}...{% endif %}</strong>
                            </p>
                        {% endif %}
                    </div>
                    
                    <!-- Toolbar Controls -->
                    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; width: 100%; justify-content: space-between; margin-top: 8px;">
                        <div style="display: flex; gap: 4px; background: var(--bg-subtle); padding: 3px; border-radius: var(--radius-md);">
                            <button type="button" id="tab-all-trainers" class="pill-btn active" onclick="switchTrainerTab('all')" style="height: 28px; padding: 0 12px; font-size: 12px;">All Candidates ({{ table_data|length }})</button>
                            <button type="button" id="tab-selected-trainers" class="pill-btn" onclick="switchTrainerTab('selected')" style="height: 28px; padding: 0 12px; font-size: 12px;">Selected (<span id="tab-selected-count">0</span>)</button>
                        </div>

                        <div style="display: flex; align-items: center; gap: 6px; background: var(--bg-card); border: 1px solid var(--border); padding: 4px 10px; border-radius: var(--radius-md);">
                            <input type="checkbox" id="chk-strong-matches" onchange="applyTableFilters()" {% if search_mode in ['email', 'phone', 'name'] %}checked{% endif %} class="form-checkbox">
                            <label for="chk-strong-matches" class="checkbox-label" style="font-size: 12px;">
                                Strong matches only (≥ 80%) <span id="approx-hidden-text" style="color: var(--text-muted);"></span>
                            </label>
                        </div>

                        <div class="form-field-inline" style="background: var(--bg-card); border: 1px solid var(--border); padding: 4px 10px; border-radius: var(--radius-md);">
                            <label for="score-slider" class="field-label-sm" style="white-space: nowrap;">Matches above: <span id="score-slider-val" style="color: var(--accent); font-weight: 600;">0%</span></label>
                            <input type="range" id="score-slider" min="0" max="100" value="0" step="5" oninput="document.getElementById('score-slider-val').textContent = this.value + '%'; applyTableFilters();" style="cursor: pointer; width: 80px;">
                        </div>

                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <div style="display: flex; align-items: center; gap: 6px; background: var(--bg-card); border: 1px solid var(--border); padding: 4px 10px; border-radius: var(--radius-md);">
                                <label for="status-filter-select" class="field-label-sm">Show:</label>
                                <select id="status-filter-select" onchange="applyTableFilters()" class="form-select-sm" style="height: 26px; padding: 0 6px; font-size: 12px;">
                                    <option value="all">All</option>
                                    <option value="used">Already Used</option>
                                    <option value="never">Never Used (New)</option>
                                    <option value="not_used">Not Used</option>
                                </select>
                                <div style="display: flex; align-items: center; gap: 4px; margin-left: 4px;">
                                    <input type="checkbox" id="chk-hide-used" class="form-checkbox">
                                    <label for="chk-hide-used" class="checkbox-label" style="font-size: 12px;">Hide Used</label>
                                    <span id="hidden-used-spinner" style="display: none;" data-icon="loader" data-size="12"></span>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 6px; background: var(--bg-card); border: 1px solid var(--border); padding: 4px 10px; border-radius: var(--radius-md);">
                                <label for="gender-filter-select" class="field-label-sm">Gender:</label>
                                <select id="gender-filter-select" onchange="applyTableFilters()" class="form-select-sm" style="height: 26px; padding: 0 6px; font-size: 12px;">
                                    <option value="all">All Genders</option>
                                    <option value="male">Male</option>
                                    <option value="female">Female</option>
                                </select>
                            </div>

                            <input type="text" id="filter-box" class="form-input-sm" placeholder="Search Name, Skill..." oninput="applyTableFilters()" style="width: 160px; height: 32px;">

                            <button type="button" class="btn-secondary" onclick="downloadCSV()" style="height: 32px; padding: 0 10px; font-size: 12px;">
                                <span data-icon="download" data-size="14"></span> CSV
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Bulk Actions Bar -->
                <div class="form-row" style="background: var(--bg-subtle); border: 1px solid var(--border); padding: 8px 12px; border-radius: var(--radius-md); margin: 10px 0;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" id="select-all-checkbox" onchange="toggleSelectAll(this)" title="Select All" class="form-checkbox">
                        <span style="font-weight: 600; color: var(--text-primary); font-size: 13px;">Select All (<span id="selected-count-badge">0</span> selected)</span>
                    </div>
                    <button type="button" id="btn-copy-selected" class="btn-primary-lg" onclick="copySelectedCandidates()" style="height: 30px; padding: 0 12px; font-size: 12px;">
                        <span data-icon="copy" data-size="14"></span> Copy Selected (0)
                    </button>
                </div>

                <div class="table-wrapper">
                    <table class="results-table" id="results-table">
                        <thead>
                            <tr>
                                <th style="text-align: center; width: 35px;">
                                    <input type="checkbox" id="header-select-all" onchange="toggleSelectAll(this)" title="Select All" class="form-checkbox">
                                </th>
                                <th style="text-align: center; width: 45px;">Rank</th>
                                <th style="width: 140px;">Name <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Name', 3, this)" title="Copy all visible Names"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="width: 75px;">Gender <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Gender', 4, this)" title="Copy all visible Genders"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="width: 170px;">Email <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Email', 5, this)" title="Copy all visible Emails"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="width: 150px;">Phone <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Phone', 6, this)" title="Copy all visible Phone Numbers"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="text-align: center; width: 95px; cursor: pointer;" onclick="sortTableByExperience()" id="th-exp">
                                    Exp <span id="sort-exp-icon">↕</span> <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="event.stopPropagation(); copyColumnData('Experience', 7, this)" title="Copy all visible Experience"><span data-icon="copy" data-size="12"></span></button>
                                </th>
                                <th style="width: 160px;">Skill Set <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Skill Set', 8, this)" title="Copy all visible Skill Sets"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="width: 130px;">Matched Skills <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Matched Skills', 9, this)" title="Copy all visible Matched Skills"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="text-align: center; width: 70px;">Score <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Match Score', 10, this)" title="Copy all visible Match Scores"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="width: 150px;">Reason <button type="button" class="btn-ghost-icon" data-column-copy="true" onclick="copyColumnData('Match Reason', 11, this)" title="Copy all visible Match Reasons"><span data-icon="copy" data-size="12"></span></button></th>
                                <th style="text-align: center; width: 85px;">Copy</th>
                            </tr>
                        </thead>
                        <tbody id="table-body">
                            {% for row in table_data %}
                                <tr id="row-{{ loop.index }}" data-email="{{ row['Email'] if row['Email'] else '' }}" data-name="{{ row['Name'] if row['Name'] else '' }}" data-phone="{{ row['Phone'] if row['Phone'] else '' }}" data-gender="{{ row['Gender'] if row['Gender'] else 'N/A' }}" data-exp-years="{{ row['experience_years'] if row['experience_years'] is not none else '' }}">
                                    <td style="text-align: center;">
                                        <input type="checkbox" class="trainer-checkbox form-checkbox" data-email="{{ row['Email'] if row['Email'] else '' }}" data-name="{{ row['Name'] if row['Name'] else '' }}" data-phone="{{ row['Phone'] if row['Phone'] else '' }}" onchange="onTrainerSelectChange()">
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="badge-status" style="background: var(--bg-subtle); color: var(--text-secondary);">#{{ row['Rank'] if 'Rank' in row else loop.index }}</span>
                                    </td>
                                    <td class="cand-name" style="font-weight: 600; color: var(--text-primary); word-break: break-word;">
                                        {{ row['Name'] }}
                                    </td>
                                    <td class="cand-gender" style="color: var(--text-secondary); font-size: 12px;">
                                        {{ row['Gender'] if row['Gender'] else 'N/A' }}
                                    </td>
                                    <td class="cand-email" style="word-break: break-word; color: var(--text-secondary); font-size: 12px;">
                                        {{ row['Email'] if row['Email'] else 'N/A' }}
                                    </td>
                                    <td class="cand-phone" style="padding-right: 12px; color: var(--text-secondary); font-size: 12px; word-break: break-word;">
                                        {{ row['Phone'] if row['Phone'] else 'N/A' }}
                                    </td>
                                    <td style="text-align: center; padding-left: 6px; padding-right: 6px; white-space: nowrap; font-weight: 600; font-size: 12px;">
                                        {% if row['experience_years'] is not none %}
                                            {{ row['experience_years'] }} yrs
                                        {% elif row['experience_unknown'] or row['Experience'] in ['N/A', 'Unknown', ''] %}
                                            <span style="color: var(--warning);" title="Experience unknown / unparseable">? yrs</span>
                                        {% else %}
                                            {{ row['Experience'] }}
                                        {% endif %}
                                    </td>

                                    <td style="font-size: 12px; line-height: 1.3; color: var(--text-primary); word-break: break-word;">
                                        {% if row.get('Resume Title') and row.get('Resume Title') != row.get('Skill Set') %}
                                            <div style="font-weight: 600; color: var(--accent); margin-bottom: 2px; background: var(--bg-subtle); padding: 2px 6px; border-radius: 4px; display: inline-block;">Title: {{ row['Resume Title'] }}</div><br>
                                        {% endif %}
                                        {{ row['Skill Set'] }}
                                    </td>
                                    <td style="font-size: 12px; line-height: 1.3; color: var(--success); word-break: break-word;">
                                        {{ row['Matched Skills'] if 'Matched Skills' in row else 'N/A' }}
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="tag-score tag-score-high tag-score-val">{{ row['Match Score'] if 'Match Score' in row else 'N/A' }}{% if row['Match Score'] and row['Match Score'] != 'N/A' %}%{% endif %}</span>
                                    </td>
                                    <td style="font-size: 12px; line-height: 1.3; color: var(--text-secondary); word-break: break-word;">
                                        {{ row['Match Reason'] if 'Match Reason' in row else 'N/A' }}
                                    </td>
                                    <td style="text-align: center; white-space: nowrap;">
                                        <button type="button" class="btn-primary-lg btn-copy-row-icon" onclick="copySingleCandidate(this)" style="height: 26px; padding: 0 8px; font-size: 12px;" title="Copy candidate details & save to Copied History">
                                            <span data-icon="copy" data-size="12"></span> Copy
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% elif job_query %}
            <div class="card" style="text-align: center; padding: 40px 20px; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border);">
                <div style="color: var(--text-muted); margin-bottom: 12px;" data-icon="search" data-size="32"></div>
                <h3 style="color: var(--text-primary); font-size: 1.1rem; font-weight: 600; margin-bottom: 6px;">No candidates found</h3>
                <p style="color: var(--text-secondary); max-width: 420px; margin: 0 auto 16px auto; font-size: 13px;">Try broadening keywords, selecting a different mailbox, or removing the experience filter.</p>
                <button type="button" class="btn-primary-lg" style="margin: auto;" onclick="document.getElementById('job_query').focus()">Try a different search</button>
            </div>
        {% else %}
            <div class="card" style="text-align: center; padding: 40px 20px; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border);">
                <div style="color: var(--text-muted); margin-bottom: 12px;" data-icon="inbox" data-size="32"></div>
                <h3 style="color: var(--text-primary); font-size: 1.1rem; font-weight: 600; margin-bottom: 6px;">Ready when you are</h3>
                <p style="color: var(--text-secondary); max-width: 420px; margin: 0 auto; font-size: 13px;">Enter keywords above and click Search Mailbox to find matching candidate resumes.</p>
            </div>
        {% endif %}
    </div>

    <!-- History Side Panel Overlay -->
    <div id="history-panel-overlay" class="panel-overlay"></div>
    <div id="history-side-panel" class="side-panel">
        <div class="panel-header">
            <h3 class="panel-title"><span data-icon="history" data-size="16"></span> Search History</h3>
            <button type="button" id="btn-close-history" class="btn-ghost-icon" aria-label="Close Side Panel"><span data-icon="x" data-size="16"></span></button>
        </div>
        <div id="history-panel-content" class="panel-content">
            <!-- Dynamic history cards -->
        </div>
    </div>

    <!-- Copied History Side Panel Overlay -->
    <div id="copied-panel-overlay" class="panel-overlay"></div>
    <div id="copied-side-panel" class="side-panel">
        <div class="panel-header">
            <h3 class="panel-title"><span data-icon="copy" data-size="16"></span> Copied History</h3>
            <button type="button" id="btn-close-copied" class="btn-ghost-icon" aria-label="Close Side Panel"><span data-icon="x" data-size="16"></span></button>
        </div>
        <div id="copied-panel-content" class="panel-content">
            <!-- Dynamic copied history content -->
        </div>
    </div>

    <!-- Modal: Skip Already-Copied Prompt -->
    <div id="skip-copied-modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px); z-index: 10010; align-items: center; justify-content: center; padding: 20px;" role="dialog" aria-modal="true">
        <div style="background: var(--bg-card); color: var(--text-primary); width: 100%; max-width: 480px; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); border: 1px solid var(--border); padding: 20px;">
            <div style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;">
                <span data-icon="info" data-size="18"></span> Previously Copied Search Detected
            </div>
            <div style="font-size: 13px; line-height: 1.4; color: var(--text-secondary); margin-bottom: 14px;">
                <p style="margin: 2px 0;"><strong>Mailbox:</strong> <span id="modal-skip-mailbox" style="color: var(--accent);"></span></p>
                <p style="margin: 2px 0;"><strong>Search:</strong> "<span id="modal-skip-jd" style="color: var(--text-primary);"></span>"</p>
                <p style="margin: 8px 0 4px 0;">You have already copied <strong id="modal-skip-count" style="color: var(--accent);">0</strong> candidate(s) for this search:</p>
                <div id="modal-skip-list" style="background: var(--bg-subtle); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 8px 12px; max-height: 100px; overflow-y: auto; font-size: 12px; color: var(--text-primary);"></div>
            </div>
            <div style="font-weight: 600; font-size: 13px; margin-bottom: 12px; color: var(--text-primary);">Choose how to display results:</div>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <button type="button" id="btn-skip-choice-skip" class="btn-primary-lg" style="justify-content: flex-start;">
                    Skip already-copied (<span id="btn-skip-count-text">0</span> hidden)
                </button>
                <button type="button" id="btn-skip-choice-show" class="btn-secondary" style="height: 36px; justify-content: flex-start;">
                    Show everything (including <span id="btn-show-count-text">0</span>)
                </button>
                <button type="button" id="btn-skip-choice-cancel" class="btn-ghost-icon" style="font-size: 12px; color: var(--text-muted); align-self: center; margin-top: 4px;">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <footer>
        <p>© 2026 ResuMatch — Minimal AI Resume Shortlisting & Candidate Extraction Engine</p>
    </footer>

    <!-- SVG Icon System Script (Lucide icons) -->
    <script src="{{ url_for('static', filename='icons/icons.js') }}"></script>
    <script src="{{ url_for('static', filename='js/ui.js') }}"></script>
    <script src="{{ url_for('static', filename='js/pagination.js') }}"></script>
    <script src="{{ url_for('static', filename='js/search-popups.js') }}"></script>
    <script src="{{ url_for('static', filename='js/copied-history-panel.js') }}"></script>
    <script src="{{ url_for('static', filename='js/copy.js') }}"></script>
    <script>
        window.__candidates = {{ table_data|tojson if table_data else [] }};

        function updateAccountBadge(accountEmail) {
            const badge = document.getElementById('active-mail-label');
            if (badge) {
                badge.textContent = accountEmail;
            }
            try {
                localStorage.setItem('preferred_account', accountEmail);
            } catch(e) {}
        }

        const searchForm = document.getElementById('search-form');
        if (searchForm) {
            searchForm.addEventListener('submit', function() {
                const indicator = document.getElementById('loading-indicator');
                const messageElem = document.getElementById('loading-message');
                const selectedMail = document.getElementById('account_email') ? document.getElementById('account_email').value : 'selected mailbox';
                if (indicator) indicator.style.display = 'block';

                const progressSteps = [
                    `Authenticating with ${selectedMail}...`,
                    `Searching mailbox ${selectedMail} for relevant candidate emails...`,
                    "Filtering and downloading resume attachments (.pdf, .docx, .doc)...",
                    "Extracting candidate contact info (Email & Phone Number)...",
                    "Analyzing Skills & Work Experience with AI...",
                    "Calculating JD Match Scores & Ranking Candidates..."
                ];

                let stepIdx = 0;
                if (messageElem) messageElem.textContent = progressSteps[stepIdx];
                const interval = setInterval(() => {
                    stepIdx = (stepIdx + 1) % progressSteps.length;
                    if (messageElem) messageElem.textContent = progressSteps[stepIdx];
                }, 2500);

                sessionStorage.setItem('loadingInterval', interval);
            });
        }

        window.addEventListener('load', function() {
            const interval = sessionStorage.getItem('loadingInterval');
            if (interval) {
                clearInterval(interval);
                sessionStorage.removeItem('loadingInterval');
            }

            const savedWin = localStorage.getItem('time_window') || 'any';
            const savedMode = localStorage.getItem('show_mode') || 'all';
            const savedFrom = localStorage.getItem('date_from') || '';
            const savedTo = localStorage.getItem('date_to') || '';

            if (savedFrom) {
                const fromHidden = document.getElementById('date_from_hidden');
                if (fromHidden) fromHidden.value = savedFrom;
                const customFrom = document.getElementById('custom_date_from');
                if (customFrom) customFrom.value = savedFrom;
            }
            if (savedTo) {
                const toHidden = document.getElementById('date_to_hidden');
                if (toHidden) toHidden.value = savedTo;
                const customTo = document.getElementById('custom_date_to');
                if (customTo) customTo.value = savedTo;
            }

            setTimeWindow(savedWin);
            setShowMode(savedMode);
            startAutoRefresh();

            const jdInput = document.getElementById('job_query');
            if (jdInput) {
                jdInput.addEventListener('input', function() {
                    triggerDebouncedGmailCount();
                });
            }

            const refreshBtn = document.getElementById('btn-refresh-counts');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', refreshAllCounts);
            }
        });

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                stopAutoRefresh();
            } else {
                if (currentTimeWindow !== 'any' && currentTimeWindow !== 'custom') {
                    refreshTimeWindowCount(currentTimeWindow);
                }
                startAutoRefresh();
            }
        });
    </script>
</body>
</html>