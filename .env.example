# AI Provider Configuration (Gemini Primary, Groq Fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_1=gemini-3.7-flash
GEMINI_FALLBACK_MODEL_2=gemini-3.6-flash
GEMINI_FALLBACK_MODEL_3=gemini-3.5-flash-lite
BATCH_SIZE_GEMINI=10

# Groq API Configuration (Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_REQUESTS_PER_MINUTE=25
BATCH_SIZE_GROQ=5

# Search & Candidate Filtering Limits
MIN_MATCH_SCORE=60
MAX_SEARCH_SECONDS=600
MAX_RESUME_CHARS=4000

# Supabase Configuration
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Gmail OAuth Token Strings (For Vercel / Cloud Deployment)
GOOGLE_TOKEN_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}
GOOGLE_TOKEN_JAI_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}
GOOGLE_TOKEN_KUMAR_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}
GOOGLE_TOKEN_PUSHPA_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}
GOOGLE_TOKEN_MAHI_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}
GOOGLE_TOKEN_CONTACT_JSON={"token": "...", "refresh_token": "...", "client_id": "...", "client_secret": "..."}
