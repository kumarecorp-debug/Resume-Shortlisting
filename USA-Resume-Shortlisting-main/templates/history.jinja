<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search History — ResuMatch</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/styles.css') }}">
</head>
<body>
    <nav class="navbar">
        <div style="display: flex; align-items: center; gap: 12px;">
            <a href="{{ url_for('process') }}" class="nav-btn" style="height: 32px; padding: 0 10px;">
                <span data-icon="chevron-right" data-size="14" style="transform: rotate(180deg);"></span> Back
            </a>
            <a href="{{ url_for('process') }}" class="nav-brand">
                <span class="nav-brand-logo" data-icon="target" data-size="18"></span>
                <span>ResuMatch</span>
            </a>
        </div>
        <div class="nav-right">
            <div class="user-menu-btn">
                <span data-icon="user" data-size="14"></span>
                <span>{{ session['user']['email'] if session.get('user') else 'Authenticated User' }}</span>
            </div>
            <a href="{{ url_for('logout') }}" class="nav-btn" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.25); color: #ef4444;">
                <span data-icon="logout" data-size="14"></span> Sign Out
            </a>
        </div>
    </nav>

    <div class="container">
        <div class="card" style="margin-bottom: 12px; padding: 14px 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h2 style="margin: 0; font-size: 16px; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 8px;">
                        <span data-icon="history" data-size="18"></span> Search History Log
                    </h2>
                    <p style="color: var(--text-secondary); margin: 2px 0 0 0; font-size: 12px;">View, filter, and re-run past searches executed over the last 30 days</p>
                </div>
            </div>
        </div>

        <div class="card">
            <form method="GET" action="{{ url_for('search_history_page') }}" id="history-filter-form">
                <div class="form-row" style="margin-bottom: 12px; gap: 10px;">
                    <div class="form-field-inline">
                        <label for="account_email" class="field-label-sm"><span data-icon="mail" data-size="14"></span> Mailbox:</label>
                        <select name="account_email" id="account_email" class="form-select-sm" onchange="this.form.submit()">
                            <option value="">All Mailboxes</option>
                            {% for acct in available_accounts %}
                                <option value="{{ acct.email }}" {% if selected_account == acct.email %}selected{% endif %}>
                                    {{ acct.name }} ({{ acct.email }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="form-field-inline">
                        <label for="from" class="field-label-sm"><span data-icon="calendar" data-size="14"></span> From:</label>
                        <input type="date" name="from" id="from" class="form-input-sm" value="{{ from_date }}">
                        <label for="to" class="field-label-sm">To:</label>
                        <input type="date" name="to" id="to" class="form-input-sm" value="{{ to_date }}">
                    </div>

                    <div class="form-field-inline">
                        <label for="search_text" class="field-label-sm"><span data-icon="search" data-size="14"></span> Filter:</label>
                        <input type="text" id="search_text" class="form-input-sm" placeholder="Type JD keyword..." oninput="filterHistoryTable()" style="width: 180px;">
                    </div>

                    <button type="submit" class="btn-primary-lg" style="height: 36px; padding: 0 14px; font-size: 13px;">
                        <span data-icon="filter" data-size="14"></span> Apply Filter
                    </button>
                </div>

                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 8px;">
                    <span class="field-label-sm">Quick:</span>
                    <button type="button" class="btn-secondary" style="height: 28px; padding: 0 10px; font-size: 12px;" onclick="setQuickDays(7)">Last 7 Days</button>
                    <button type="button" class="btn-secondary" style="height: 28px; padding: 0 10px; font-size: 12px;" onclick="setQuickDays(30)">Last 30 Days</button>
                    <a href="{{ url_for('search_history_page') }}" class="btn-secondary" style="height: 28px; padding: 0 10px; font-size: 12px; text-decoration: none;">Reset All</a>
                </div>
            </form>

            <div class="table-wrapper" style="margin-top: 12px;">
                <table class="results-table">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Mailbox Account</th>
                            <th>Job Query / Description</th>
                            <th style="text-align: center;">Batch Limit</th>
                            <th style="text-align: center;">Candidates Found</th>
                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if history_records and history_records|length > 0 %}
                            {% for rec in history_records %}
                                <tr class="history-row" data-jd="{{ rec['job_description']|lower }}">
                                    <td style="white-space: nowrap; font-weight: 500; color: var(--text-primary);">
                                        {{ rec['formatted_time'] if rec.get('formatted_time') else rec['searched_at'][:16].replace('T', ' ') }}
                                    </td>
                                    <td style="white-space: nowrap; font-weight: 500; color: var(--accent);">
                                        {{ rec['mailbox_account'] }}
                                    </td>
                                    <td style="max-width: 360px; word-break: break-word;">
                                        <strong>{{ rec['job_description'][:100] }}</strong>{% if rec['job_description']|length > 100 %}...{% endif %}
                                    </td>
                                    <td style="text-align: center; font-weight: 500;">
                                        {{ rec['batch_size'] }}
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="tag-score tag-score-high">{{ rec['results_count'] }} Candidates</span>
                                    </td>
                                    <td style="text-align: center; white-space: nowrap;">
                                        <div style="display: flex; gap: 6px; justify-content: center;">
                                            <form method="POST" action="{{ url_for('process') }}" style="display: inline;">
                                                <input type="hidden" name="account_email" value="{{ rec['mailbox_account'] }}">
                                                <input type="hidden" name="job_query" value="{{ rec['job_description'] }}">
                                                <input type="hidden" name="max_candidates" value="{{ rec['batch_size'] }}">
                                                <button type="submit" class="btn-primary-lg" style="height: 28px; padding: 0 10px; font-size: 12px;">
                                                    <span data-icon="refresh-cw" data-size="12"></span> Re-run
                                                </button>
                                            </form>
                                            <button type="button" class="btn-secondary" style="height: 28px; padding: 0 10px; font-size: 12px;" onclick="viewHistoryItem('{{ rec['id'] }}')">
                                                <span data-icon="file-text" data-size="12"></span> Details
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 32px; color: var(--text-muted);">
                                    No search history records found for the selected filter date range.
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal for Search History Details -->
    <div id="details-modal" class="panel-overlay">
        <div class="card" style="width: 100%; max-width: 520px; max-height: 80vh; overflow-y: auto; padding: 20px; border-radius: var(--radius-lg); margin: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-bottom: 14px;">
                <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: var(--text-primary);" id="modal-title">Search Details</h3>
                <button type="button" onclick="closeModal()" class="btn-ghost-icon"><span data-icon="x" data-size="16"></span></button>
            </div>
            <div id="modal-body" style="font-size: 13px;">
                <p style="color: var(--text-secondary);">Loading candidate details...</p>
            </div>
            <div style="text-align: right; margin-top: 16px; border-top: 1px solid var(--border); padding-top: 10px;">
                <button type="button" class="btn-primary-lg" style="height: 32px; padding: 0 14px; font-size: 13px;" onclick="closeModal()">Close</button>
            </div>
        </div>
    </div>

    <script src="{{ url_for('static', filename='icons/icons.js') }}"></script>
    <script>
        function filterHistoryTable() {
            const query = (document.getElementById('search_text')?.value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('.history-row');
            rows.forEach(row => {
                const jd = row.getAttribute('data-jd') || '';
                const fullText = row.textContent.toLowerCase();
                if (!query || jd.includes(query) || fullText.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function setQuickDays(d) {
            const form = document.getElementById('history-filter-form');
            document.getElementById('from').value = '';
            document.getElementById('to').value = '';
            const hiddenDays = document.createElement('input');
            hiddenDays.type = 'hidden';
            hiddenDays.name = 'days';
            hiddenDays.value = d;
            form.appendChild(hiddenDays);
            form.submit();
        }

        function viewHistoryItem(id) {
            const modal = document.getElementById('details-modal');
            const body = document.getElementById('modal-body');
            modal.style.display = 'flex';
            modal.classList.add('active');
            body.innerHTML = '<p style="color: var(--text-secondary);">Fetching details...</p>';

            fetch('/api/history/' + id)
                .then(res => res.json())
                .then(res => {
                    if (res.success && res.data) {
                        const data = res.data;
                        let candHtml = '';
                        if (data.candidates_seen && data.candidates_seen.length > 0) {
                            candHtml = '<ul style="padding-left: 20px; line-height: 1.5; max-height: 220px; overflow-y: auto;">';
                            data.candidates_seen.forEach(c => {
                                let cName = 'Candidate';
                                let cEmail = 'N/A';
                                if (typeof c === 'string') {
                                    cEmail = c;
                                    cName = c.includes('@') ? c.split('@')[0] : c;
                                } else if (c && typeof c === 'object') {
                                    cName = c.Name || c.name || (c.Email || c.email ? (c.Email || c.email).split('@')[0] : 'Candidate');
                                    cEmail = c.Email || c.email || 'N/A';
                                }
                                candHtml += `<li><strong style="color: var(--text-primary);">${cName}</strong> <span style="color: var(--text-secondary);">(${cEmail})</span></li>`;
                            });
                            candHtml += '</ul>';
                        } else {
                            candHtml = '<p style="color: var(--text-muted);">No candidate list cached for this search.</p>';
                        }

                        body.innerHTML = `
                            <p style="margin: 4px 0;"><strong>Mailbox:</strong> <span style="color: var(--accent);">${data.mailbox_account}</span></p>
                            <p style="margin: 4px 0;"><strong>Date & Time:</strong> ${data.searched_at}</p>
                            <p style="margin: 4px 0;"><strong>Job Description:</strong> "${data.job_description}"</p>
                            <p style="margin: 4px 0;"><strong>Batch Limit:</strong> ${data.batch_size} &nbsp;·&nbsp; <strong>Found:</strong> ${data.results_count}</p>
                            <h4 style="margin-top: 14px; margin-bottom: 6px; color: var(--text-primary); font-size: 13px;">Candidates Returned (${data.results_count}):</h4>
                            ${candHtml}
                        `;
                    } else {
                        body.innerHTML = '<p style="color: var(--danger);">Failed to load search details.</p>';
                    }
                })
                .catch(err => {
                    body.innerHTML = '<p style="color: var(--danger);">Error: ' + err + '</p>';
                });
        }

        function closeModal() {
            const modal = document.getElementById('details-modal');
            modal.style.display = 'none';
            modal.classList.remove('active');
        }
    </script>
</body>
</html>
