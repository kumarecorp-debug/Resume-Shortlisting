<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search History - AI Resume Shortlisting</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='index.css') }}">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8fafc;
        }
        .container {
            flex: 1;
            max-width: 1350px;
            margin: 0 auto;
            padding: 20px;
            width: 96%;
        }
        .card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            padding: 28px;
            margin-bottom: 24px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37,99,235,0.25);
        }
        .btn-secondary {
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #cbd5e1;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
        }
        .btn-secondary:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            background: #f1f5f9;
            padding: 16px 20px;
            border-radius: 10px;
            border: 1.5px solid #cbd5e1;
            margin-bottom: 20px;
        }
        .filter-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .filter-input {
            padding: 8px 12px;
            border: 1.5px solid #cbd5e1;
            border-radius: 6px;
            font-size: 0.9rem;
            outline: none;
        }
        .filter-input:focus {
            border-color: #2563eb;
        }
        .table-wrapper {
            max-height: 600px;
            overflow-y: auto;
            overflow-x: auto;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }
        .history-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.92rem;
            background: #ffffff;
        }
        .history-table th {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #1e293b;
            color: #ffffff;
            text-align: left;
            padding: 12px 14px;
            font-weight: 600;
            font-size: 0.9rem;
        }
        .history-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #f1f5f9;
            color: #334155;
            vertical-align: middle;
        }
        .history-table tr:hover {
            background-color: #f8fafc;
        }
        .badge-count {
            background: #dcfce7;
            color: #15803d;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.84rem;
        }
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15,23,42,0.6);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }
        .modal-content {
            background: #ffffff;
            border-radius: 12px;
            max-width: 700px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }
    </style>
</head>
<body>
    <header style="text-align: center; padding: 24px 0 10px 0; position: relative;">
        <div style="position: absolute; left: 24px; top: 20px;">
            <a href="{{ url_for('process') }}" class="btn-secondary">
                ← Back to Search
            </a>
        </div>
        <div style="position: absolute; right: 24px; top: 20px; display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 0.88rem; color: #475569; background: #e2e8f0; padding: 6px 12px; border-radius: 20px; font-weight: 500;">
                👤 {{ session['user']['email'] if session.get('user') else 'Authenticated User' }}
            </span>
            <a href="{{ url_for('logout') }}" style="background: #dc2626; color: white; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 0.88rem; font-weight: 600;">
                Sign Out 🚪
            </a>
        </div>
        <h1 style="margin: 0; color: #0f172a;">Search History Log</h1>
        <p style="color: #64748b; margin-top: 6px;">View, filter, and re-run past resume searches executed over the last 30 days</p>
    </header>

    <div class="container">
        <div class="card">
            <form method="GET" action="{{ url_for('search_history_page') }}" id="history-filter-form">
                <div class="filter-bar">
                    <div class="filter-group">
                        <label for="account_email" style="font-weight: 700; color: #0f172a; font-size: 0.92rem;">📬 Mailbox:</label>
                        <select name="account_email" id="account_email" class="filter-input" onchange="this.form.submit()">
                            <option value="">All Mailboxes</option>
                            {% for acct in available_accounts %}
                                <option value="{{ acct.email }}" {% if selected_account == acct.email %}selected{% endif %}>
                                    {{ acct.name }} ({{ acct.email }})
                                </option>
                            {% endfor %}
                        </select>

                        <label for="from" style="font-weight: 700; color: #0f172a; font-size: 0.92rem; margin-left: 10px;">📅 From:</label>
                        <input type="date" name="from" id="from" class="filter-input" value="{{ from_date }}">

                        <label for="to" style="font-weight: 700; color: #0f172a; font-size: 0.92rem;">To:</label>
                        <input type="date" name="to" id="to" class="filter-input" value="{{ to_date }}">

                        <label for="search_text" style="font-weight: 700; color: #0f172a; font-size: 0.92rem; margin-left: 10px;">🔍 Search Query / Skill:</label>
                        <input type="text" id="search_text" class="filter-input" placeholder="Type JD skill (e.g. Python, D365)..." oninput="filterHistoryTable()" style="width: 220px;">

                        <button type="submit" class="btn-primary">Filter Date Range 🔍</button>
                    </div>

                    <div class="filter-group">
                        <span style="font-weight: 600; color: #64748b; font-size: 0.88rem;">Quick Filters:</span>
                        <button type="button" class="btn-secondary" onclick="setQuickDays(7)">Last 7 Days</button>
                        <button type="button" class="btn-secondary" onclick="setQuickDays(30)">Last 30 Days</button>
                        <a href="{{ url_for('search_history_page') }}" class="btn-secondary">Reset All</a>
                    </div>
                </div>
            </form>

            <div class="table-wrapper">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Mailbox Account</th>
                            <th>Job Query / Description</th>
                            <th style="text-align: center;">Batch Size</th>
                            <th style="text-align: center;">Candidates Found</th>
                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if history_records and history_records|length > 0 %}
                            {% for rec in history_records %}
                                <tr class="history-row" data-jd="{{ rec['job_description']|lower }}">
                                    <td style="white-space: nowrap; font-weight: 600; color: #1e293b;">
                                        {{ rec['formatted_time'] if rec.get('formatted_time') else rec['searched_at'][:16].replace('T', ' ') }}
                                    </td>
                                    <td style="white-space: nowrap; font-weight: 500; color: #2563eb;">
                                        {{ rec['mailbox_account'] }}
                                    </td>
                                    <td style="max-width: 380px; word-break: break-word; font-size: 0.9rem;">
                                        <strong>{{ rec['job_description'][:100] }}</strong>{% if rec['job_description']|length > 100 %}...{% endif %}
                                    </td>
                                    <td style="text-align: center; font-weight: 600;">
                                        {{ rec['batch_size'] }}
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="badge-count">{{ rec['results_count'] }} Candidates</span>
                                    </td>
                                    <td style="text-align: center; white-space: nowrap;">
                                        <div style="display: flex; gap: 8px; justify-content: center;">
                                            <form method="POST" action="{{ url_for('process') }}" style="display: inline;">
                                                <input type="hidden" name="account_email" value="{{ rec['mailbox_account'] }}">
                                                <input type="hidden" name="job_query" value="{{ rec['job_description'] }}">
                                                <input type="hidden" name="max_candidates" value="{{ rec['batch_size'] }}">
                                                <button type="submit" class="btn-primary" style="padding: 6px 12px; font-size: 0.82rem;">
                                                    🔄 Re-run
                                                </button>
                                            </form>
                                            <button type="button" class="btn-secondary" style="padding: 6px 12px; font-size: 0.82rem;" onclick="viewHistoryItem('{{ rec['id'] }}')">
                                                👁️ Details
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 40px; color: #64748b;">
                                    No search history records found for the selected filter date range.
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal for Search History Details -->
    <div id="details-modal" class="modal-overlay">
        <div class="modal-content">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 12px; margin-bottom: 16px;">
                <h3 style="margin: 0; color: #0f172a;" id="modal-title">Search Details</h3>
                <button type="button" onclick="closeModal()" style="background: none; border: none; font-size: 1.4rem; cursor: pointer;">✕</button>
            </div>
            <div id="modal-body">
                <p style="color: #64748b;">Loading candidate details...</p>
            </div>
            <div style="text-align: right; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 12px;">
                <button type="button" class="btn-secondary" onclick="closeModal()">Close</button>
            </div>
        </div>
    </div>

    <script>
        function filterHistoryTable() {
            const query = (document.getElementById('search_text')?.value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('.history-row');
            rows.forEach(row => {
                const jd = row.getAttribute('data-jd') || '';
                const fullText = row.textContent.toLowerCase();
                if (!query || jd.includes(query) || fullText.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function setQuickDays(d) {
            const form = document.getElementById('history-filter-form');
            document.getElementById('from').value = '';
            document.getElementById('to').value = '';
            const hiddenDays = document.createElement('input');
            hiddenDays.type = 'hidden';
            hiddenDays.name = 'days';
            hiddenDays.value = d;
            form.appendChild(hiddenDays);
            form.submit();
        }

        function viewHistoryItem(id) {
            const modal = document.getElementById('details-modal');
            const body = document.getElementById('modal-body');
            modal.style.display = 'flex';
            body.innerHTML = '<p style="color: #64748b;">Fetching details...</p>';

            fetch('/api/history/' + id)
                .then(res => res.json())
                .then(res => {
                    if (res.success && res.data) {
                        const data = res.data;
                        let candHtml = '';
                        if (data.candidates_seen && data.candidates_seen.length > 0) {
                            candHtml = '<ul style="padding-left: 20px; line-height: 1.6;">';
                            data.candidates_seen.forEach(c => {
                                candHtml += `<li><strong>${c.Name || 'Candidate'}</strong> (${c.Email || 'N/A'})</li>`;
                            });
                            candHtml += '</ul>';
                        } else {
                            candHtml = '<p style="color: #94a3b8;">No candidate list cached for this search.</p>';
                        }

                        body.innerHTML = `
                            <p><strong>Mailbox:</strong> ${data.mailbox_account}</p>
                            <p><strong>Date & Time:</strong> ${data.searched_at}</p>
                            <p><strong>Job Description:</strong> ${data.job_description}</p>
                            <p><strong>Batch Limit:</strong> ${data.batch_size} | <strong>Found:</strong> ${data.results_count}</p>
                            <h4 style="margin-top: 16px; color: #1e293b;">Candidates Returned (${data.results_count}):</h4>
                            ${candHtml}
                        `;
                    } else {
                        body.innerHTML = '<p style="color: #ef4444;">Failed to load search details.</p>';
                    }
                })
                .catch(err => {
                    body.innerHTML = '<p style="color: #ef4444;">Error: ' + err + '</p>';
                });
        }

        function closeModal() {
            document.getElementById('details-modal').style.display = 'none';
        }
    </script>
</body>
</html>
